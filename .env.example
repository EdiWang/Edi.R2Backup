# Five-field CRON: every Thursday at 02:00 in TZ.
BACKUP_CRON="0 2 * * 4"
TZ=Etc/UTC

R2_REMOTE=r2
R2_BUCKETS="bucket-one bucket-two"

LOCAL_BACKUP_PATH=/srv/r2-backup
# Keep credentials outside the repository and the backup directory.
RCLONE_CONFIG_PATH=/etc/edi-r2backup/rclone.conf
PUID=1000
PGID=1000
